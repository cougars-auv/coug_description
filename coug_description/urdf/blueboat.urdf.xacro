<robot name="blueboat" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="tf_prefix" default="" />
  <xacro:property name="tf_prefix" value="$(arg tf_prefix)" />

  <xacro:include filename="$(find coug_description)/urdf/common.xacro" />

  <xacro:property name="base_height" value="0.40" />
  <xacro:property name="base_width" value="0.93" />
  <xacro:property name="base_length" value="1.20" />
  <!-- 14.5 kg dry + 2x 4S Li-ion batteries + sensor payload -->
  <xacro:property name="base_mass" value="18.0" />

  <xacro:property name="thruster_xoff" value="-0.488" />
  <xacro:property name="thruster_yoff" value="0.295" />
  <xacro:property name="thruster_zoff" value="-0.272" />
  <xacro:property name="thruster_mass" value="0.2" />

  <xacro:property name="blueboat_depth_camera_xyz" value="0.45 0 0.15" />
  <xacro:property name="blueboat_depth_camera_rpy" value="0 ${radians(10)} 0" />

  <material name="Black">
    <color rgba="0.01 0.01 0.01 1" />
  </material>
  <material name="Blue">
    <color rgba="0 0 1 1" />
  </material>
  <material name="Yellow">
    <color rgba="1 1 0 1" />
  </material>

  <xacro:macro name="mesh_visual" params="mesh color rpy:='0 0 0'">
    <visual>
      <origin xyz="0 0 0" rpy="${rpy}" />
      <geometry>
        <mesh filename="package://ardupilot_sitl_models/models/blueboat/meshes/blueboat_${mesh}.dae" />
      </geometry>
      <material name="${color}" />
    </visual>
  </xacro:macro>

  <!-- Hull -->
  <link name="${tf_prefix}base_link">
    <xacro:mesh_visual mesh="hull" color="Blue" />
    <xacro:mesh_visual mesh="aerial" color="Black" />
    <xacro:mesh_visual mesh="crosstube" color="Black" />
    <xacro:mesh_visual mesh="flag" color="Yellow" />
    <xacro:mesh_visual mesh="frame_asm_aft" color="Black" />
    <xacro:mesh_visual mesh="frame_asm_fore" color="Black" />
    <xacro:mesh_visual mesh="hatch_asm_port" color="Black" />
    <xacro:mesh_visual mesh="hatch_asm_stbd" color="Black" />
    <xacro:mesh_visual mesh="motor_port" color="Black" />
    <xacro:mesh_visual mesh="motor_stbd" color="Black" />
    <collision>
      <geometry>
        <mesh filename="package://ardupilot_sitl_models/models/blueboat/meshes/blueboat_hull_collision.stl" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.05 0 -0.15" />
      <mass value="${base_mass}" />
      <inertia ixx="${base_mass*(base_width*base_width + base_height*base_height)/12}" ixy="0" ixz="0" iyy="${base_mass*(base_length*base_length + base_height*base_height)/12}" iyz="0" izz="${base_mass*(base_length*base_length + base_width*base_width)/12}" />
    </inertial>
  </link>

  <!-- Thrusters -->
  <xacro:macro name="thruster" params="prefix y_reflect mesh">
    <joint name="${prefix}_thruster_joint" type="continuous">
      <parent link="${tf_prefix}base_link" />
      <child link="${tf_prefix}${prefix}_thruster_link" />
      <origin xyz="${thruster_xoff} ${y_reflect*thruster_yoff} ${thruster_zoff}" rpy="0 0 0" />
      <axis xyz="1 0 0" />
      <dynamics damping="0.02" />
    </joint>
    <link name="${tf_prefix}${prefix}_thruster_link">
      <xacro:mesh_visual mesh="${mesh}" color="Black" rpy="${radians(-90)} 0 ${radians(90)}" />
      <inertial>
        <mass value="${thruster_mass}" />
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
      </inertial>
    </link>
  </xacro:macro>

  <xacro:thruster prefix="left" y_reflect="1" mesh="prop_port" />
  <xacro:thruster prefix="right" y_reflect="-1" mesh="prop_stbd" />

  <!-- Sensors -->
  <xacro:sensor_frame name="gps" xyz="0.16 -0.365 0.03" />
  <xacro:sensor_frame name="imu" xyz="0.16 -0.365 -0.07" />
  <xacro:sensor_frame name="depth_camera" xyz="${blueboat_depth_camera_xyz}" rpy="${blueboat_depth_camera_rpy}" />
  <xacro:optical_frame name="depth_camera" />

</robot>
