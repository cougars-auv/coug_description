<?xml version="1.0"?>
<robot name="rover" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="base_height" value="0.15" />
  <xacro:property name="base_width" value="0.5" />
  <xacro:property name="base_length" value="0.4" />
  <xacro:property name="base_xoff" value="0.135" />
  <xacro:property name="base_mass" value="18.0" />

  <xacro:property name="wheel_radius" value="0.15" />
  <xacro:property name="wheel_width" value="0.2" />
  <xacro:property name="wheel_xoff" value="0.7" />
  <xacro:property name="wheel_yoff" value="${base_width/2 + 0.1 + wheel_width/2}" />
  <xacro:property name="wheel_zoff" value="0.15" />
  <xacro:property name="wheel_mass" value="2.5" />

  <xacro:property name="mast_height" value="1.2" />
  <xacro:property name="mast_width" value="0.08" />
  <xacro:property name="mast_length" value="0.04" />
  <xacro:property name="mast_mass" value="1.5" />

  <material name="LightGray">
    <color rgba="0.8 0.8 0.8 1" />
  </material>
  <material name="DarkGray">
    <color rgba="0.2 0.2 0.2 1" />
  </material>

  <!-- Helpful macros -->
  <xacro:macro name="add_box" params="color mass xyz rpy x y z">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <box size="${x} ${y} ${z}" />
      </geometry>
      <material name="${color}" />
    </visual>
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <box size="${x} ${y} ${z}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <mass value="${mass}" />
      <inertia ixx="${mass*(y*y + z*z)/12}" ixy="0" ixz="0" iyy="${mass*(x*x + z*z)/12}" iyz="0" izz="${mass*(x*x + y*y)/12}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="add_cylinder" params="color mass xyz rpy radius length">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <cylinder radius="${radius}" length="${length}" />
      </geometry>
      <material name="${color}" />
    </visual>
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <cylinder radius="${radius}" length="${length}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <mass value="${mass}" />
      <inertia ixx="${mass*(3*radius*radius + length*length)/12}" ixy="0" ixz="0"
        iyy="${mass*(3*radius*radius + length*length)/12}" iyz="0" izz="${mass*radius*radius/2}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix xoff y_reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="${base_xoff + xoff} ${y_reflect*wheel_yoff} ${-wheel_zoff}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <dynamics damping="0.05" friction="0.1" />
    </joint>
    <link name="${prefix}_wheel_link">
      <xacro:add_cylinder color="DarkGray" mass="${wheel_mass}" xyz="0 0 0" rpy="${radians(90)} 0 0"
        radius="${wheel_radius}" length="${wheel_width}" />
    </link>
  </xacro:macro>

  <!-- Chassis -->
  <link name="base_link">
    <xacro:add_box color="LightGray" mass="${base_mass}" xyz="0 0 0" rpy="0 0 0" x="${base_length}" y="${base_width}" z="${base_height}" />
  </link>

  <!-- Wheels -->
  <xacro:wheel prefix="front_left" xoff="${wheel_xoff}" y_reflect="1" />
  <xacro:wheel prefix="front_right" xoff="${wheel_xoff}" y_reflect="-1" />
  <xacro:wheel prefix="middle_left" xoff="0" y_reflect="1" />
  <xacro:wheel prefix="middle_right" xoff="0" y_reflect="-1" />
  <xacro:wheel prefix="rear_left" xoff="${-wheel_xoff}" y_reflect="1" />
  <xacro:wheel prefix="rear_right" xoff="${-wheel_xoff}" y_reflect="-1" />

  <!-- Mast -->
  <joint name="mast_joint" type="fixed">
    <parent link="base_link" />
    <child link="mast_link" />
    <origin xyz="${base_length/2 + mast_length/2} 0 ${mast_height/2 - base_height/2}" rpy="0 0 0" />
  </joint>
  <link name="mast_link">
    <xacro:add_box color="LightGray" mass="${mast_mass}" xyz="0 0 0" rpy="0 0 0" x="${mast_length}" y="${mast_width}" z="${mast_height}" />
  </link>

  <!-- Sensors -->
  <joint name="depth_camera_joint" type="fixed">
    <parent link="mast_link" />
    <child link="depth_camera_link" />
    <origin xyz="0.12 0 0.05" rpy="0 0.1 0" />
  </joint>
  <link name="depth_camera_link" />

  <joint name="depth_camera_optical_joint" type="fixed">
    <parent link="depth_camera_link" />
    <child link="depth_camera_optical_link" />
    <origin xyz="0 0 0" rpy="${radians(-90)} 0 ${radians(-90)}" />
  </joint>
  <link name="depth_camera_optical_link" />

  <joint name="imu_joint" type="fixed">
    <parent link="depth_camera_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="imu_link" />

  <joint name="gps_joint" type="fixed">
    <parent link="base_link" />
    <child link="gps_link" />
    <origin xyz="${-base_length/2} 0 ${base_height/2}" rpy="0 0 0" />
  </joint>
  <link name="gps_link" />

</robot>
