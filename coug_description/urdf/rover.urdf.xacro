<?xml version="1.0"?>
<robot name="rover" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="agent_ns" default="rover" />
  <xacro:property name="agent_ns" value="$(arg agent_ns)" />

  <xacro:property name="base_height" value="0.15" />
  <xacro:property name="base_width" value="0.5" />
  <xacro:property name="base_length" value="0.4" />
  <xacro:property name="base_xoff" value="0.135" />
  <xacro:property name="base_mass" value="18.0" />

  <xacro:property name="wheel_radius" value="0.15" />
  <xacro:property name="wheel_width" value="0.2" />
  <xacro:property name="wheel_xoff" value="0.7" />
  <xacro:property name="wheel_yoff" value="${base_width/2 + 0.1 + wheel_width/2}" />
  <xacro:property name="wheel_zoff" value="0.15" />
  <xacro:property name="wheel_mass" value="2.5" />

  <xacro:property name="mast_height" value="1.2" />
  <xacro:property name="mast_width" value="0.08" />
  <xacro:property name="mast_length" value="0.04" />
  <xacro:property name="mast_mass" value="1.5" />

  <material name="LightGray">
    <color rgba="0.8 0.8 0.8 1" />
  </material>
  <material name="DarkGray">
    <color rgba="0.2 0.2 0.2 1" />
  </material>

  <!-- Helpful macros -->
  <xacro:macro name="add_box" params="color mass xyz rpy x y z">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <box size="${x} ${y} ${z}" />
      </geometry>
      <material name="${color}" />
    </visual>
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <box size="${x} ${y} ${z}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <mass value="${mass}" />
      <inertia ixx="${mass*(y*y + z*z)/12}" ixy="0" ixz="0" iyy="${mass*(x*x + z*z)/12}" iyz="0" izz="${mass*(x*x + y*y)/12}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="add_cylinder" params="color mass xyz rpy radius length">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <cylinder radius="${radius}" length="${length}" />
      </geometry>
      <material name="${color}" />
    </visual>
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <cylinder radius="${radius}" length="${length}" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <mass value="${mass}" />
      <inertia ixx="${mass*(3*radius*radius + length*length)/12}" ixy="0" ixz="0"
        iyy="${mass*(3*radius*radius + length*length)/12}" iyz="0" izz="${mass*radius*radius/2}" />
    </inertial>
  </xacro:macro>

  <xacro:macro name="add_imu_noise" params="stddev">
    <xacro:macro name="add_axis_noise">
      <noise type="gaussian">
        <mean>0.0</mean>
        <stddev>${stddev}</stddev>
      </noise>
    </xacro:macro>
    <x>
      <xacro:add_axis_noise />
    </x>
    <y>
      <xacro:add_axis_noise />
    </y>
    <z>
      <xacro:add_axis_noise />
    </z>
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix xoff y_reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="${base_xoff + xoff} ${y_reflect*wheel_yoff} ${-wheel_zoff}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <dynamics damping="0.05" friction="0.1" />
    </joint>
    <link name="${prefix}_wheel_link">
      <xacro:add_cylinder color="DarkGray" mass="${wheel_mass}" xyz="0 0 0" rpy="${radians(90)} 0 0"
        radius="${wheel_radius}" length="${wheel_width}" />
    </link>
  </xacro:macro>

  <!-- Chassis -->
  <link name="base_link">
    <xacro:add_box color="LightGray" mass="${base_mass}" xyz="0 0 0" rpy="0 0 0" x="${base_length}" y="${base_width}" z="${base_height}" />
  </link>

  <!-- Wheels -->
  <xacro:wheel prefix="front_left" xoff="${wheel_xoff}" y_reflect="1" />
  <xacro:wheel prefix="front_right" xoff="${wheel_xoff}" y_reflect="-1" />
  <xacro:wheel prefix="middle_left" xoff="0" y_reflect="1" />
  <xacro:wheel prefix="middle_right" xoff="0" y_reflect="-1" />
  <xacro:wheel prefix="rear_left" xoff="${-wheel_xoff}" y_reflect="1" />
  <xacro:wheel prefix="rear_right" xoff="${-wheel_xoff}" y_reflect="-1" />

  <!-- Mast -->
  <joint name="mast_joint" type="fixed">
    <parent link="base_link" />
    <child link="mast_link" />
    <origin xyz="${base_length/2 + mast_length/2} 0 ${mast_height/2 - base_height/2}" rpy="0 0 0" />
  </joint>
  <link name="mast_link">
    <xacro:add_box color="LightGray" mass="${mast_mass}" xyz="0 0 0" rpy="0 0 0" x="${mast_length}" y="${mast_width}" z="${mast_height}" />
  </link>

  <!-- Sensors -->
  <joint name="depth_camera_joint" type="fixed">
    <parent link="mast_link" />
    <child link="depth_camera_link" />
    <origin xyz="0.12 0 0.05" rpy="0 0.1 0" />
  </joint>
  <link name="depth_camera_link" />

  <joint name="depth_camera_optical_joint" type="fixed">
    <parent link="depth_camera_link" />
    <child link="depth_camera_optical_link" />
    <origin xyz="0 0 0" rpy="${radians(-90)} 0 ${radians(-90)}" />
  </joint>
  <link name="depth_camera_optical_link" />

  <joint name="imu_joint" type="fixed">
    <parent link="depth_camera_link" />
    <child link="imu_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="imu_link" />

  <joint name="gps_joint" type="fixed">
    <parent link="base_link" />
    <child link="gps_link" />
    <origin xyz="${-base_length/2} 0 ${base_height/2}" rpy="0 0 0" />
  </joint>
  <link name="gps_link" />

  <!-- Gazebo plugins -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>middle_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>middle_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${2*wheel_yoff}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/${agent_ns}/cmd_vel</topic>
      <odom_topic>/${agent_ns}/wheel/odom</odom_topic>
      <child_frame_id>${agent_ns}/base_link</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/${agent_ns}/joint_states</topic>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <!-- https://github.com/stereolabs/zed-ros2-wrapper/blob/v5.4.1/zed_wrapper/config/zed2i.yaml#L11 -->
      <odom_publish_frequency>60</odom_publish_frequency>
      <odom_topic>/${agent_ns}/camera/odom</odom_topic>
      <odom_covariance_topic>/${agent_ns}/camera/odom_with_covariance</odom_covariance_topic>
      <odom_frame>${agent_ns}/odom</odom_frame>
      <robot_base_frame>${agent_ns}/base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- Gazebo sensors -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/${agent_ns}/camera/imu/data</topic>
      <gz_frame_id>${agent_ns}/imu_link</gz_frame_id>
      <imu>
        <enable_orientation>true</enable_orientation>
        <orientation_reference_frame>
          <localization>ENU</localization>
        </orientation_reference_frame>
        <!-- 0.007 °/s/√Hz * √100 Hz -> 1.2e-3 rad/s
          0.0016 m/s^2/√Hz * √100 Hz -> 1.6e-2 m/s^2
          https://github.com/stereolabs/zed-sdk/issues/487
          https://github.com/stereolabs/zed-ros2-wrapper/blob/v5.4.1/zed_wrapper/config/common_stereo.yaml#L64 -->
        <angular_velocity>
          <xacro:add_imu_noise stddev="1.2e-3" />
        </angular_velocity>
        <linear_acceleration>
          <xacro:add_imu_noise stddev="1.6e-2" />
        </linear_acceleration>
      </imu>
    </sensor>

    <sensor name="magnetometer" type="magnetometer">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>/${agent_ns}/camera/imu/mag</topic>
      <gz_frame_id>${agent_ns}/imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="gps_link">
    <sensor name="gps" type="navsat">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>/${agent_ns}/gps/fix</topic>
      <gz_frame_id>${agent_ns}/gps_link</gz_frame_id>
      <navsat>
        <!-- https://content.u-blox.com/sites/default/files/documents/ZED-F9P-01B_DataSheet_UBX-17051259.pdf -->
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <!-- Lat/lon degrees, not meters -->
              <stddev>1.35e-7</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.025</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </navsat>
    </sensor>
  </gazebo>

  <gazebo reference="depth_camera_link">
    <sensor name="depth_camera" type="rgbd_camera">
      <always_on>true</always_on>
      <!-- <update_rate>60</update_rate> -->
      <update_rate>20</update_rate>
      <topic>/${agent_ns}/camera/depth</topic>
      <gz_frame_id>${agent_ns}/depth_camera_link</gz_frame_id>
      <camera>
        <!-- https://www.stereolabs.com/en-us/products/zed-2i
          https://github.com/stereolabs/zed-ros2-wrapper/blob/v5.4.1/zed_wrapper/config/zed2i.yaml#L10-L20
          https://github.com/stereolabs/zed-ros2-wrapper/blob/v5.4.1/zed_wrapper/config/common_stereo.yaml#L30-L33
          https://support.stereolabs.com/articles/9175329825 -->
        <horizontal_fov>${radians(110)}</horizontal_fov>
        <!-- <horizontal_fov>${radians(68)}</horizontal_fov> -->
        <image>
          <!-- <width>1280</width>
          <height>720</height> -->
          <width>640</width>
          <height>360</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.3</near>
            <!-- <near>1.5</near> -->
            <far>15.0</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

</robot>
