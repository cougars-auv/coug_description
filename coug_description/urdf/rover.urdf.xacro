<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="tf_prefix" default="" />
  <xacro:property name="tf_prefix" value="$(arg tf_prefix)" />

  <xacro:include filename="$(find coug_description)/urdf/common.xacro" />

  <xacro:property name="base_height" value="0.15" />
  <xacro:property name="base_width" value="0.5" />
  <xacro:property name="base_length" value="0.4" />
  <xacro:property name="base_xoff" value="0.135" />
  <xacro:property name="base_mass" value="18.0" />

  <xacro:property name="wheel_radius" value="0.15" />
  <xacro:property name="wheel_width" value="0.2" />
  <xacro:property name="wheel_xoff" value="0.7" />
  <xacro:property name="wheel_yoff" value="${base_width/2 + 0.1 + wheel_width/2}" />
  <xacro:property name="wheel_zoff" value="0.15" />
  <xacro:property name="wheel_mass" value="2.5" />

  <xacro:property name="mast_height" value="1.2" />
  <xacro:property name="mast_width" value="0.08" />
  <xacro:property name="mast_length" value="0.04" />
  <xacro:property name="mast_mass" value="1.5" />

  <xacro:property name="depth_camera_xoff" value="0.12" />
  <xacro:property name="depth_camera_zoff" value="0.05" />
  <xacro:property name="depth_camera_pitch" value="0.1" />
  <!-- Depth camera pose relative to base_link -->
  <xacro:property name="rover_depth_camera_xyz" value="${base_length/2 + mast_length/2 + depth_camera_xoff} 0 ${mast_height/2 - base_height/2 + depth_camera_zoff}" />
  <xacro:property name="rover_depth_camera_rpy" value="0 ${depth_camera_pitch} 0" />

  <material name="LightGray">
    <color rgba="0.8 0.8 0.8 1" />
  </material>
  <material name="DarkGray">
    <color rgba="0.2 0.2 0.2 1" />
  </material>

  <!-- TODO: Compare this with the new 2026 URDF -->

  <!-- Chassis -->
  <link name="${tf_prefix}base_link">
    <xacro:box_shape color="LightGray" x="${base_length}" y="${base_width}" z="${base_height}" mass="${base_mass}" />
  </link>

  <!-- Wheels -->
  <xacro:macro name="wheel" params="prefix xoff y_reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${tf_prefix}base_link" />
      <child link="${tf_prefix}${prefix}_wheel_link" />
      <origin xyz="${base_xoff + xoff} ${y_reflect*wheel_yoff} ${-wheel_zoff}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <dynamics damping="0.05" friction="0.1" />
    </joint>
    <link name="${tf_prefix}${prefix}_wheel_link">
      <xacro:cylinder_shape color="DarkGray" radius="${wheel_radius}" length="${wheel_width}" rpy="${radians(90)} 0 0" mass="${wheel_mass}" />
    </link>
  </xacro:macro>

  <xacro:wheel prefix="front_left" xoff="${wheel_xoff}" y_reflect="1" />
  <xacro:wheel prefix="front_right" xoff="${wheel_xoff}" y_reflect="-1" />
  <xacro:wheel prefix="middle_left" xoff="0" y_reflect="1" />
  <xacro:wheel prefix="middle_right" xoff="0" y_reflect="-1" />
  <xacro:wheel prefix="rear_left" xoff="${-wheel_xoff}" y_reflect="1" />
  <xacro:wheel prefix="rear_right" xoff="${-wheel_xoff}" y_reflect="-1" />

  <!-- Mast -->
  <xacro:fixed_joint name="mast" xyz="${base_length/2 + mast_length/2} 0 ${mast_height/2 - base_height/2}" />
  <link name="${tf_prefix}mast_link">
    <xacro:box_shape color="LightGray" x="${mast_length}" y="${mast_width}" z="${mast_height}" mass="${mast_mass}" />
  </link>

  <!-- Sensors -->
  <xacro:sensor_frame name="depth_camera" parent="mast" xyz="${depth_camera_xoff} 0 ${depth_camera_zoff}" rpy="${rover_depth_camera_rpy}" />
  <xacro:optical_frame name="depth_camera" />
  <xacro:sensor_frame name="imu" parent="depth_camera" />
  <xacro:sensor_frame name="gps" xyz="${-base_length/2} 0 ${base_height/2}" />

</robot>
