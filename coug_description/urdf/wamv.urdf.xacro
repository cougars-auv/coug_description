<robot name="wamv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="tf_prefix" default="" />
  <xacro:property name="tf_prefix" value="$(arg tf_prefix)" />
  <xacro:arg name="namespace" default="${tf_prefix.rstrip('/')}" />

  <xacro:include filename="$(find coug_description)/urdf/common.xacro" />
  <xacro:include filename="$(find wamv_description)/urdf/wamv_base.urdf.xacro" />
  <xacro:include filename="$(find wamv_gazebo)/urdf/thruster_layouts/wamv_aft_thrusters.xacro" />

  <xacro:property name="wamv_depth_camera_xyz" value="2.0 0 2.0" />
  <xacro:property name="wamv_depth_camera_rpy" value="0 ${radians(15)} 0" />

  <!-- Platform -->
  <xacro:sensor_frame name="gps" xyz="0.55 0 1.3" />
  <xacro:sensor_frame name="imu" xyz="0.55 0 1.3" />
  <xacro:sensor_frame name="depth_camera" xyz="${wamv_depth_camera_xyz}" rpy="${wamv_depth_camera_rpy}" />
  <xacro:optical_frame name="depth_camera" />

</robot>
