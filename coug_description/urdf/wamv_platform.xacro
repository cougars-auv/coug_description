<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="wamv_depth_camera_xyz" value="2.0 0 2.0" />
  <xacro:property name="wamv_depth_camera_rpy" value="0 ${radians(15)} 0" />

  <xacro:macro name="wamv_platform" params="prefix:=''">
    <joint name="${prefix}gps_joint" type="fixed">
      <parent link="${prefix}base_link" />
      <child link="${prefix}gps_link" />
      <origin xyz="0.55 0 1.3" rpy="0 0 0" />
    </joint>
    <link name="${prefix}gps_link" />

    <joint name="${prefix}imu_joint" type="fixed">
      <parent link="${prefix}base_link" />
      <child link="${prefix}imu_link" />
      <origin xyz="0.55 0 1.3" rpy="0 0 0" />
    </joint>
    <link name="${prefix}imu_link" />

    <joint name="${prefix}depth_camera_joint" type="fixed">
      <parent link="${prefix}base_link" />
      <child link="${prefix}depth_camera_link" />
      <origin xyz="${wamv_depth_camera_xyz}" rpy="${wamv_depth_camera_rpy}" />
    </joint>
    <link name="${prefix}depth_camera_link" />

    <joint name="${prefix}depth_camera_optical_joint" type="fixed">
      <parent link="${prefix}depth_camera_link" />
      <child link="${prefix}depth_camera_optical_link" />
      <origin xyz="0 0 0" rpy="${radians(-90)} 0 ${radians(-90)}" />
    </joint>
    <link name="${prefix}depth_camera_optical_link" />
  </xacro:macro>

</robot>
