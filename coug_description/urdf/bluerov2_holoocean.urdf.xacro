<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bluerov2">

  <xacro:property name="mass" value="9.5" />
  <xacro:property name="ixx" value="0.16" />
  <xacro:property name="iyy" value="0.17" />
  <xacro:property name="izz" value="0.12" />

  <!-- Main BlueROV2 body -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://coug_description/urdf/meshes/bluerov2/bluerov2.dae"
          scale="0.025 0.025 0.025" />
      </geometry>
    </visual>
  </link>

  <xacro:macro name="thruster" params="name xyz rpy mesh vis_rpy">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link" />
      <child link="${name}_link" />
      <origin xyz="${xyz}" rpy="${rpy}" />
    </joint>
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${vis_rpy}" />
        <geometry>
          <mesh filename="package://coug_description/urdf/meshes/bluerov2/${mesh}" />
        </geometry>
      </visual>
    </link>
  </xacro:macro>

  <xacro:thruster name="thruster1" xyz="0.14 -0.092 0.0" rpy="-1.571 1.571 -0.785"
    mesh="t200_ccw_prop.dae" vis_rpy="-1.571 0 0" />
  <xacro:thruster name="thruster2" xyz="0.14 0.092 0.0" rpy="-1.571 1.571 -2.356"
    mesh="t200_ccw_prop.dae" vis_rpy="-1.571 0 0" />
  <xacro:thruster name="thruster3" xyz="-0.14 -0.092 0.0" rpy="-1.571 1.571 0.785"
    mesh="t200_cw_prop.dae" vis_rpy="1.571 0 0" />
  <xacro:thruster name="thruster4" xyz="-0.14 0.092 0.0" rpy="-1.571 1.571 2.356"
    mesh="t200_cw_prop.dae" vis_rpy="1.571 0 0" />
  <xacro:thruster name="thruster5" xyz="0.118 -0.215 0.064" rpy="0 0 0" mesh="t200_ccw_prop.dae"
    vis_rpy="-1.571 0 1.571" />
  <xacro:thruster name="thruster6" xyz="0.118 0.215 0.064" rpy="0 0 0" mesh="t200_cw_prop.dae"
    vis_rpy="1.571 0 1.571" />
  <xacro:thruster name="thruster7" xyz="-0.118 -0.215 0.064" rpy="0 0 0" mesh="t200_cw_prop.dae"
    vis_rpy="1.571 0 1.571" />
  <xacro:thruster name="thruster8" xyz="-0.118 0.215 0.064" rpy="0 0 0" mesh="t200_ccw_prop.dae"
    vis_rpy="-1.571 0 1.571" />

  <!-- NOTE: These are exact HoloOcean socket locations as of 2.3.0 -->

  <!-- COM -->
  <joint name="com_joint" type="fixed">
    <parent link="base_link" />
    <child link="com_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="com_link" />

  <joint name="gps_joint" type="fixed">
    <parent link="com_link" />
    <child link="gps_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="gps_link" />

  <joint name="modem_joint" type="fixed">
    <parent link="com_link" />
    <child link="modem_link" />
    <!-- Sensor FLU frame; FRD data converted by seatrac_x150_imu_depth/base_status_poller -->
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <link name="modem_link" />

  <!-- IMUSocket -->
  <joint name="imu_joint" type="fixed">
    <parent link="com_link" />
    <child link="imu_link" />
    <!-- IMU pitched 180 deg in socket due to robot_localization gravity mishandling bug -->
    <origin xyz="0.11 0 0.065" rpy="0 0 0" />
  </joint>
  <link name="imu_link" />

  <!-- DepthSocket -->
  <joint name="depth_joint" type="fixed">
    <parent link="com_link" />
    <child link="depth_link" />
    <origin xyz="-0.17 0 0.06" rpy="0 0 0" />
  </joint>
  <link name="depth_link" />

  <!-- DVLSocket -->
  <joint name="dvl_joint" type="fixed">
    <parent link="com_link" />
    <child link="dvl_link" />
    <!-- Sensor FLU frame; FRD data converted by dvl_a50_twist_beams/dvl_a50_odom -->
    <origin xyz="0 -0.1 -0.1" rpy="0 0 0" />
  </joint>
  <link name="dvl_link" />

  <xacro:macro name="dvl_beam" params="name yaw">
    <joint name="${name}_joint" type="fixed">
      <parent link="dvl_link" />
      <child link="${name}_link" />
      <!-- +X axis down each DVL beam -->
      <origin xyz="0 0 0" rpy="0 ${radians(67.5)} ${yaw}" />
    </joint>
    <link name="${name}_link" />
  </xacro:macro>

  <xacro:dvl_beam name="beam0" yaw="${radians(0)}" />
  <xacro:dvl_beam name="beam1" yaw="${radians(90)}" />
  <xacro:dvl_beam name="beam2" yaw="${radians(180)}" />
  <xacro:dvl_beam name="beam3" yaw="${radians(-90)}" />

  <!-- CameraSocket -->
  <joint name="camera_joint" type="fixed">
    <parent link="com_link" />
    <child link="camera_link" />
    <origin xyz="0.21 0 0.06" rpy="0 0 0" />
  </joint>
  <link name="camera_link" />

  <!-- SonarSocket -->
  <joint name="sonar_joint" type="fixed">
    <parent link="com_link" />
    <child link="sonar_link" />
    <origin xyz="0.15 0 0.14" rpy="0 0 0" />
  </joint>
  <link name="sonar_link" />

  <!-- Configured stereo camera poses (optical frame) -->
  <joint name="front_stereo_joint" type="fixed">
    <parent link="dvl_link" />
    <child link="front_stereo_link" />
    <origin xyz="0.1 0 0" rpy="${pi} 0 ${-pi/2}" />
  </joint>
  <link name="front_stereo_link" />

  <joint name="back_stereo_joint" type="fixed">
    <parent link="dvl_link" />
    <child link="back_stereo_link" />
    <origin xyz="-0.1 0 0" rpy="${pi} 0 ${-pi/2}" />
  </joint>
  <link name="back_stereo_link" />

</robot>
